# =============================================================================
# ai-images version pins — sourced by build/push scripts and compose
# =============================================================================

# NVIDIA CUDA base image tag (nvidia/cuda:<tag>)
CUDA_IMAGE_TAG=12.8.1-cudnn-devel-ubuntu22.04

# Python
PYTHON_VERSION=3.12

# PyTorch 2.7.0 + CUDA 12.8 wheels (ABI-compatible trio)
# CRITICAL: All three must match to avoid torchaudio ABI errors
TORCH_VERSION=2.7.0
TORCHVISION_VERSION=0.22.0
TORCHAUDIO_VERSION=2.7.0
TORCH_CUDA=cu128
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128

# Engine framework pins
VLLM_VERSION=0.8.5
SGLANG_VERSION=0.4.6
# ComfyUI >= 0.30.0 required for native MiniMax-H3 nodes
COMFYUI_REF=v0.37.0
COMFYUI_TAG=v0.37.0-torch2.7
# Diffusers API engine (for image generation models like Qwen-Image-2.1)
DIFFUSERS_API_TAG=v1
# NOTE: diffusers>=0.33.0 for QwenImage21Pipeline (verify latest stable version)

# Product tags
PRODUCT_VIDEO_MINIMAX_H3_SINGULARITY_TAG=v1.2

# Qwen-Image-2.1 product tags (6 SKUs: 2 runtimes × 3 VRAM variants)
PRODUCT_QWEN_IMAGE_21_DIFFUSERS_4090_24G_TAG=v1
PRODUCT_QWEN_IMAGE_21_DIFFUSERS_48G_TAG=v1
PRODUCT_QWEN_IMAGE_21_DIFFUSERS_5090_TAG=v1
PRODUCT_QWEN_IMAGE_21_COMFYUI_4090_24G_TAG=v1
PRODUCT_QWEN_IMAGE_21_COMFYUI_48G_TAG=v1
PRODUCT_QWEN_IMAGE_21_COMFYUI_5090_TAG=v1

# Image registry / naming
# Set IMAGE_REGISTRY=ghcr.io/gpurun in environment for GHCR push
# Leave empty for local tags: base/<name>:<tag>, engine/<name>:<tag>, product/<name>:<tag>

# Base image tags
BASE_CUDA_RUNTIME_TAG=cu128
BASE_PYTHON_ML_TAG=cu128-py312-torch2.7
BASE_PYTHON_ML_CU129_TAG=cu129-py312-torch2.13

# Engine tags
ENGINE_VDN_SERVE_TAG=v1

# VDN-MiniMax-H3 product tag
PRODUCT_VIDEO_VDN_MINIMAX_H3_TAG=v1

# DeepSeek-V4.1-Flash
DEEPSEEK_V4_1_FLASH_MODEL=deepseek-ai/DeepSeek-V4.1
DEEPSEEK_V4_1_FLASH_REVISION=main
DEEPSEEK_V4_1_FLASH_SERVED_NAME=DeepSeek-V4.1-Flash
DEEPSEEK_V4_1_FLASH_CONTEXT_LENGTH=1048576
DEEPSEEK_V4_1_FLASH_MAX_PREFILL_TOKENS=65536
DEEPSEEK_V4_1_FLASH_CHUNKED_PREFILL=4096
DEEPSEEK_V4_1_FLASH_MAX_NUM_SEQS=64
DEEPSEEK_V4_1_FLASH_MAX_NUM_BATCHED_TOKENS=65536
DEEPSEEK_V4_1_FLASH_GPU_MEM_UTIL=0.90
DEEPSEEK_V4_1_FLASH_BLOCK_SIZE=128

# GLM-5.3-Flash
GLM_5_3_FLASH_MODEL=zai-org/GLM-5.3-Flash
GLM_5_3_FLASH_REVISION=main
GLM_5_3_FLASH_SERVED_NAME=GLM-5.3-Flash
GLM_5_3_FLASH_CONTEXT_LENGTH=1048576
GLM_5_3_FLASH_MAX_PREFILL_TOKENS=65536
GLM_5_3_FLASH_CHUNKED_PREFILL=8192
GLM_5_3_FLASH_MAX_NUM_SEQS=128
GLM_5_3_FLASH_MAX_NUM_BATCHED_TOKENS=65536
GLM_5_3_FLASH_GPU_MEM_UTIL=0.92
GLM_5_3_FLASH_BLOCK_SIZE=128

# GLM-5.3
GLM_5_3_MODEL=zai-org/GLM-5.3
GLM_5_3_REVISION=main
GLM_5_3_SERVED_NAME=GLM-5.3
GLM_5_3_CONTEXT_LENGTH=1048576
GLM_5_3_MAX_PREFILL_TOKENS=65536
GLM_5_3_CHUNKED_PREFILL=4096
GLM_5_3_MAX_NUM_SEQS=64
GLM_5_3_MAX_NUM_BATCHED_TOKENS=65536
GLM_5_3_GPU_MEM_UTIL=0.90
GLM_5_3_BLOCK_SIZE=128
