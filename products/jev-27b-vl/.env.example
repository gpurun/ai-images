# Model（需下载到本地目录：serve_decide.py 与 adapter 必须是本地文件）
#   huggingface-cli download autotrust/JEV-27B-VL --local-dir ./models/JEV-27B-VL
MODEL_PATH=/models/JEV-27B-VL
SERVED_MODEL_NAME=autotrust/JEV-27B-VL
HF_TOKEN=

# Serving
HOST=0.0.0.0
VLLM_PORT=8000

# Parallelism
# 不在 .env 中设置 TP_SIZE：两个 compose 各自带默认值
#   docker-compose.vllm-2gpu.yaml -> TP=2（单卡 >= 48GB 推荐）
#   docker-compose.vllm-4gpu.yaml -> TP=4（单卡 >= 24GB，如 RTX 4090）
# 如需覆盖可在本文件显式写 TP_SIZE=

# Context & batching
# JEV 硬约束：MAX_NUM_SEQS 必须为 8（批内 >8 序列时 System 1 概率错误）
# 完整 256K 上下文设 CONTEXT_LENGTH=262144（KV Cache 约需 17 GB）
CONTEXT_LENGTH=32768
MAX_NUM_SEQS=8
MAX_LORA_RANK=32
MAX_LOGPROBS=256
MAX_IMAGES_PER_PROMPT=8

# Memory
GPU_MEMORY_UTILIZATION=0.90

# JEV System 1：留空则自动探测 $MODEL_PATH/serve_decide.py
JEV_DECIDE_SCRIPT=

# Logging
DISABLE_LOG_REQUESTS=true

# Hardware（2 卡用 GPU_ID_0/GPU_ID_1；4 卡另用 GPU_ID_2/GPU_ID_3）
GPU_ID_0=0
GPU_ID_1=1
GPU_ID_2=2
GPU_ID_3=3
SHM_SIZE=64g
HF_CACHE_DIR=~/.cache/huggingface
MODELS_DIR=./models
