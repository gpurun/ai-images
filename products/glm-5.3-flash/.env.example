MODEL_PATH=zai-org/GLM-5.3-Flash
SERVED_MODEL_NAME=GLM-5.3-Flash
HF_TOKEN=
HOST=0.0.0.0
SGLANG_PORT=30000
VLLM_PORT=8000
TP_SIZE=4
EP_SIZE=4
ENABLE_EP_MOE=true
CONTEXT_LENGTH=1048576
MAX_RUNNING_REQUESTS=128
MAX_PREFILL_TOKENS=65536
CHUNKED_PREFILL_SIZE=8192
MAX_NUM_SEQS=128
MAX_NUM_BATCHED_TOKENS=65536
BLOCK_SIZE=128
GPU_MEMORY_UTILIZATION=0.92
MEM_FRACTION_STATIC=0.90
KV_CACHE_DTYPE=fp8_e4m3
SGLANG_DSA_PREFILL_BACKEND=trtllm
SGLANG_DSA_DECODE_BACKEND=trtllm
SGLANG_MOE_RUNNER_BACKEND=deep_gemm
VLLM_ATTENTION_BACKEND=FLASH_ATTN_MLA_SPARSE
ENABLE_MTP=false
MTP_NUM_SPECULATIVE_TOKENS=2
LOG_LEVEL=info
DISABLE_LOG_REQUESTS=true
REASONING_PARSER=glm45
TOOL_CALL_PARSER=glm47
ENABLE_AUTO_TOOL_CHOICE=true
ENABLE_THINKING=true
VLLM_CUDAGRAPH_MODE=PIECEWISE
SHM_SIZE=64g
GPUS='"device=0,1,2,3"'
HF_CACHE_DIR=~/.cache/huggingface

# Ollama (GGUF serving, port 11434)
OLLAMA_PORT=11434
OLLAMA_MODEL=glm-5.3-flash
# 拉取源：官方库仅提供 :cloud 标签（需 Ollama Cloud 登录）；本地 GGUF 例:
# OLLAMA_PULL=hf.co/unsloth/GLM-5.3-Flash-GGUF:UD-Q4_K_XL
OLLAMA_PULL=
GGUF_PATH=
OLLAMA_CONTEXT_LENGTH=131072
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_FLASH_ATTENTION=1
OLLAMA_NUM_PARALLEL=4
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=-1
MODELS_DIR=./models
AUTO_DOWNLOAD_WEIGHTS=0
