MODEL_PATH=Qwen/Qwen3.8-Flash-Next
SERVED_MODEL_NAME=Qwen3.8-Flash-Next
HF_TOKEN=
HOST=0.0.0.0
SGLANG_PORT=30000
VLLM_PORT=8000
TP_SIZE=1
EP_SIZE=1
ENABLE_EP_MOE=false
CONTEXT_LENGTH=131072
MAX_RUNNING_REQUESTS=256
MAX_PREFILL_TOKENS=32768
CHUNKED_PREFILL_SIZE=8192
MAX_NUM_SEQS=256
MAX_NUM_BATCHED_TOKENS=32768
BLOCK_SIZE=128
GPU_MEMORY_UTILIZATION=0.90
MEM_FRACTION_STATIC=0.90
KV_CACHE_DTYPE=fp8_e4m3
SGLANG_MOE_RUNNER_BACKEND=deep_gemm
VLLM_ATTENTION_BACKEND=FLASH_ATTN
ENABLE_MTP=false
MTP_NUM_SPECULATIVE_TOKENS=2
LOG_LEVEL=info
DISABLE_LOG_REQUESTS=true
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3
ENABLE_AUTO_TOOL_CHOICE=true
ENABLE_THINKING=true
VLLM_CUDAGRAPH_MODE=PIECEWISE
SHM_SIZE=64g
GPUS='"device=0"'
HF_CACHE_DIR=~/.cache/huggingface

# Ollama (GGUF serving, port 11434)
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen3.8-flash-next
# 拉取源例（按显存选择量化）:
# OLLAMA_PULL=qwen3.8-flash-next:125b-a6b-q4_K_M   # 官方库, 约 120GB, 256K 窗口
# OLLAMA_PULL=hf.co/unsloth/Qwen3.8-Flash-Next-GGUF:UD-Q4_K_M
OLLAMA_PULL=
GGUF_PATH=
OLLAMA_CONTEXT_LENGTH=131072
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_FLASH_ATTENTION=1
OLLAMA_NUM_PARALLEL=4
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=-1
MODELS_DIR=./models
AUTO_DOWNLOAD_WEIGHTS=0
