# =============================================================================
# Product: Qwen-Image-2.1 on ComfyUI (multi-VRAM variant)
# Variants: 4090-24g, 48g, 5090
# Requires: ComfyUI-GGUF for 24g quantized path (if using GGUF models)
# =============================================================================

ARG BASE_IMAGE=engine/comfyui:v0.37.0
FROM ${BASE_IMAGE}

ARG VARIANT=4090-24g
ENV VARIANT=${VARIANT}

# Model configuration
ENV COMFYUI_PORT=8188 \
    WEIGHTS_ROOT=/models \
    MODEL_PATH=/models \
    AUTO_DOWNLOAD_WEIGHTS=0 \
    HF_HOME=/models/hf

# Install ComfyUI custom nodes for Qwen-Image-2.1 support
# NOTE: As of Dec 2024, check if there's official Qwen-Image-2.1 ComfyUI support
# For now, install ComfyUI-GGUF for potential quantized workflow (24g variant)
# and assume standard diffusers node or custom Qwen node will be available
RUN cd /opt/ComfyUI/custom_nodes && \
    # ComfyUI-GGUF for GGUF model loading (useful for 24g variant)
    git clone https://github.com/city96/ComfyUI-GGUF.git && \
    cd ComfyUI-GGUF && \
    python -m pip install -r requirements.txt

# Variant-specific configuration
RUN case "${VARIANT}" in \
      4090-24g) \
        echo "export QUANT_MODE=fp8" >> /etc/profile.d/variant.sh && \
        echo "export DEFAULT_WIDTH=1024" >> /etc/profile.d/variant.sh && \
        echo "export DEFAULT_HEIGHT=1024" >> /etc/profile.d/variant.sh \
        ;; \
      48g) \
        echo "export QUANT_MODE=bf16" >> /etc/profile.d/variant.sh && \
        echo "export DEFAULT_WIDTH=2048" >> /etc/profile.d/variant.sh && \
        echo "export DEFAULT_HEIGHT=2048" >> /etc/profile.d/variant.sh \
        ;; \
      5090) \
        echo "export QUANT_MODE=bf16" >> /etc/profile.d/variant.sh && \
        echo "export DEFAULT_WIDTH=1536" >> /etc/profile.d/variant.sh && \
        echo "export DEFAULT_HEIGHT=1536" >> /etc/profile.d/variant.sh \
        ;; \
      *) \
        echo "Unknown VARIANT: ${VARIANT}" >&2; exit 1 \
        ;; \
    esac

COPY --from=shared /download_weights.sh /usr/local/bin/download_weights.sh
COPY --from=shared /entrypoint-comfyui.sh /usr/local/bin/entrypoint-product.sh
RUN chmod +x /usr/local/bin/download_weights.sh /usr/local/bin/entrypoint-product.sh

# Prepare mount points
RUN mkdir -p /models /output /input \
    && mkdir -p /opt/ComfyUI/models/checkpoints \
               /opt/ComfyUI/models/diffusion_models \
               /opt/ComfyUI/output \
               /opt/ComfyUI/input

EXPOSE 8188
WORKDIR /opt/ComfyUI

VOLUME ["/models", "/output", "/input"]

ENTRYPOINT ["/usr/local/bin/entrypoint-product.sh"]
CMD ["serve"]
