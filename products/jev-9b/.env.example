# Model（文本模式：System 1 + System 2，纯文本）
# 需下载到本地目录（serve_decide.py 与 adapter 必须是本地文件）：
#   huggingface-cli download autotrust/JEV-9B --local-dir ./models/JEV-9B
MODEL_PATH=/models/JEV-9B
SERVED_MODEL_NAME=autotrust/JEV-9B
HF_TOKEN=

# Serving
HOST=0.0.0.0
VLLM_PORT=8000

# Parallelism（单卡 4090）
TP_SIZE=1

# Context & batching
# JEV 硬约束：MAX_NUM_SEQS 必须为 8（批内 >8 序列时 System 1 概率错误）
CONTEXT_LENGTH=8192
MAX_NUM_SEQS=8
MAX_LORA_RANK=32
MAX_LOGPROBS=256

# Memory
GPU_MEMORY_UTILIZATION=0.90

# JEV System 1：serve_decide.py 路径（留空则自动探测 $MODEL_PATH/serve_decide.py 或 $MODEL_PATH/vl/serve_decide.py）
JEV_DECIDE_SCRIPT=

# Vision 模式（docker-compose.vllm-vl.yaml）：Qwen3.5-9B 视觉底座 + JEV-9B vl adapter
#   huggingface-cli download Qwen/Qwen3.5-9B --revision c202236235762e1c871ad0ccb60c8ee5ba337b9a --local-dir ./models/Qwen3.5-9B
VISION_BASE_PATH=/models/Qwen3.5-9B
JEV_VL_DIR=/models/JEV-9B
JEV_VL_DECIDE_SCRIPT=/models/JEV-9B/vl/serve_decide.py
VISION_CONTEXT_LENGTH=32768
MAX_IMAGES_PER_PROMPT=8

# Logging
DISABLE_LOG_REQUESTS=true

# Hardware
GPU_ID=0
SHM_SIZE=64g
HF_CACHE_DIR=~/.cache/huggingface
MODELS_DIR=./models
