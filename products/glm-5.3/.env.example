MODEL_PATH=zai-org/GLM-5.3
SERVED_MODEL_NAME=GLM-5.3
HF_TOKEN=
HOST=0.0.0.0
SGLANG_PORT=30000
VLLM_PORT=8000
TP_SIZE=8
EP_SIZE=8
ENABLE_EP_MOE=true
CONTEXT_LENGTH=1048576
MAX_RUNNING_REQUESTS=64
MAX_PREFILL_TOKENS=65536
CHUNKED_PREFILL_SIZE=4096
MAX_NUM_SEQS=64
MAX_NUM_BATCHED_TOKENS=65536
BLOCK_SIZE=128
GPU_MEMORY_UTILIZATION=0.90
MEM_FRACTION_STATIC=0.90
KV_CACHE_DTYPE=fp8_e4m3
SGLANG_DSA_PREFILL_BACKEND=trtllm
SGLANG_DSA_DECODE_BACKEND=trtllm
SGLANG_MOE_RUNNER_BACKEND=deep_gemm
VLLM_ATTENTION_BACKEND=FLASH_ATTN_MLA_SPARSE
ENABLE_MTP=false
MTP_NUM_SPECULATIVE_TOKENS=2
LOG_LEVEL=info
DISABLE_LOG_REQUESTS=true
REASONING_PARSER=glm45
TOOL_CALL_PARSER=glm47
ENABLE_AUTO_TOOL_CHOICE=true
ENABLE_THINKING=true
VLLM_CUDAGRAPH_MODE=PIECEWISE
SHM_SIZE=128g
GPUS='"device=0,1,2,3,4,5,6,7"'
HF_CACHE_DIR=~/.cache/huggingface
