# Model
MODEL_PATH=deepseek-ai/DeepSeek-V4.1
SERVED_MODEL_NAME=DeepSeek-V4.1-Flash
HF_TOKEN=

# Serving
HOST=0.0.0.0
SGLANG_PORT=30000
VLLM_PORT=8000

# Parallelism (671B FP8 recommended: TP8 + EP8)
TP_SIZE=8
EP_SIZE=8
ENABLE_EP_MOE=true

# Context & batching
CONTEXT_LENGTH=1048576
MAX_RUNNING_REQUESTS=64
MAX_PREFILL_TOKENS=65536
CHUNKED_PREFILL_SIZE=4096
MAX_NUM_SEQS=64
MAX_NUM_BATCHED_TOKENS=65536
BLOCK_SIZE=128

# Memory
GPU_MEMORY_UTILIZATION=0.90
MEM_FRACTION_STATIC=0.90

# KV Cache
KV_CACHE_DTYPE=fp8_e4m3

# Backends
SGLANG_ATTENTION_BACKEND=flashmla
SGLANG_MOE_RUNNER_BACKEND=deep_gemm
VLLM_ATTENTION_BACKEND=FLASH_ATTN_MLA

# Speculative decoding (MTP)
ENABLE_MTP=true
MTP_NUM_SPECULATIVE_TOKENS=2

# Logging
LOG_LEVEL=info
DISABLE_LOG_REQUESTS=true

# Parsers
REASONING_PARSER=deepseek_v3
TOOL_CALL_PARSER=deepseek_v3
ENABLE_AUTO_TOOL_CHOICE=true
ENABLE_THINKING=true

# vLLM
VLLM_CUDAGRAPH_MODE=PIECEWISE

# Hardware
SHM_SIZE=128g
GPUS='"device=0,1,2,3,4,5,6,7"'
HF_CACHE_DIR=~/.cache/huggingface

# Ollama (GGUF serving, port 11434)
OLLAMA_PORT=11434
OLLAMA_MODEL=deepseek-v4.1-flash
# 拉取源：官方库仅提供 :cloud 标签（需 Ollama Cloud 登录）；本地建议挂载 GGUF 或用 HF GGUF 仓库
# 例: OLLAMA_PULL=hf.co/vcruz305/DeepSeek-V4.1-Flash-GGUF:Q3_K_M （约 323GB）
OLLAMA_PULL=
GGUF_PATH=
OLLAMA_CONTEXT_LENGTH=131072
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_FLASH_ATTENTION=1
OLLAMA_NUM_PARALLEL=4
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=-1
MODELS_DIR=./models
AUTO_DOWNLOAD_WEIGHTS=0
